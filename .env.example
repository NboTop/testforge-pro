# ============================================================
# GitHub API — Required for live PR creation to demo repo
# ============================================================
GITHUB_TOKEN=
GITHUB_DEMO_OWNER=
GITHUB_DEMO_REPO=

# ============================================================
# Google Gemini — Optional, enables live AI test generation
# Server-side only. NEVER use NEXT_PUBLIC_ for this key.
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# IBM watsonx.ai — Architecture ready, not yet live
# ============================================================
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_REGION=us-south
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ============================================================